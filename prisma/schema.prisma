datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. BUSINESS, BRANCHES, RBAC & SETTINGS
// ==========================================

model Business {
  id              String         @id @default(cuid())
  name            String         @db.VarChar(150)
  legalEntityName String?        @db.VarChar(150)
  gstin           String?        @db.VarChar(15)
  bisLicense      String?        @db.VarChar(50)
  panNumber       String?        @db.VarChar(10)
  phone           String         @db.VarChar(20)
  email           String?        @db.VarChar(100)
  address         String         @db.Text
  city            String         @db.VarChar(50)
  state           String         @db.VarChar(50)
  pincode         String         @db.VarChar(10)
  currency        String         @default("INR") @db.VarChar(5)
  logoUrl         String?        @db.Text
  createdAt       DateTime       @default(now()) @db.Timestamptz
  updatedAt       DateTime       @updatedAt @db.Timestamptz

  branches               Branch[]
  users                  User[]
  products               Product[]
  stockItems             StockItem[]
  invoices               Invoice[]
  customers              Customer[]
  suppliers              Supplier[]
  karigars               Karigar[]
  metalRates             MetalRate[]
  girviLoans             GirviLoan[]
  accounts               Account[]
  journalEntries         JournalEntry[]
  consignmentMemos       ConsignmentMemo[]
  b2bPartners            B2BPartner[]
  repairJobs             RepairJob[]
  customBookingOrders    CustomBookingOrder[]
  jobCards               JobCard[]
  purchaseInvoices       PurchaseInvoice[]
  supplierPayments       SupplierPayment[]
  dailyCashClosings      DailyCashClosing[]
  shopExpenses           ShopExpense[]
  staffMembers           StaffMember[]
  staffPayments          StaffPayment[]
  showroomMasterSettings ShowroomMasterSettings?

  @@map("businesses")
}

model Branch {
  id          String      @id @default(cuid())
  businessId  String
  name        String      @db.VarChar(100)
  code        String      @db.VarChar(10)
  phone       String?     @db.VarChar(20)
  address     String?     @db.Text
  isMainVault Boolean     @default(false)
  createdAt   DateTime    @default(now()) @db.Timestamptz

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  stockItems  StockItem[]
  invoices    Invoice[]
  users       User[]

  @@unique([businessId, code])
  @@map("branches")
}

enum RoleType {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
  SALESPERSON
  INVENTORY_CLERK
  KARIGAR_MANAGER
}

model User {
  id             String      @id @default(cuid())
  businessId     String
  branchId       String?
  fullName       String      @db.VarChar(100)
  email          String      @unique @db.VarChar(100)
  phone          String      @db.VarChar(20)
  passwordHash   String      @db.Text
  role           RoleType    @default(SALESPERSON)
  isActive       Boolean     @default(true)
  monthlySalary  Decimal?    @db.Decimal(12, 2)
  advanceBalance Decimal     @default(0) @db.Decimal(12, 2)
  lastLoginAt    DateTime?   @db.Timestamptz
  createdAt      DateTime    @default(now()) @db.Timestamptz
  updatedAt      DateTime    @updatedAt @db.Timestamptz

  business       Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch         Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  auditLogs      AuditLog[]

  @@map("users")
}

model ShowroomMasterSettings {
  id                 String   @id @default(cuid())
  businessId         String   @unique
  showroomName       String   @db.VarChar(150)
  tagline            String?  @db.VarChar(150)
  addressLine1       String   @db.VarChar(200)
  addressLine2       String?  @db.VarChar(200)
  city               String   @db.VarChar(50)
  state              String   @db.VarChar(50)
  pincode            String   @db.VarChar(10)
  stateCode          String   @default("08") @db.VarChar(5)
  contactPhones      String[] 
  email              String?  @db.VarChar(100)
  gstin              String   @db.VarChar(15)
  bisHallmarkLicense String?  @db.VarChar(50)
  panNumber          String?  @db.VarChar(10)
  cinNumber          String?  @db.VarChar(30)
  invoiceFormat      String   @default("A4_DETAILED") @db.VarChar(30)
  defaultTaxRate     Decimal  @default(3.0) @db.Decimal(4, 2)
  thermalPrinterWidth Int     @default(50)
  barcodeTagFormat   String   @default("TAG_50x25_BUTTERFLY") @db.VarChar(40)
  updatedAt          DateTime @updatedAt @db.Timestamptz

  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("showroom_master_settings")
}

// ==========================================
// 2. METAL RATES & VALUATION RULES
// ==========================================

enum MetalType {
  GOLD
  SILVER
  PLATINUM
}

model MetalRate {
  id            String      @id @default(cuid())
  businessId    String
  metal         MetalType
  purityKey     String      @db.VarChar(10) // 24K, 22K, 18K, 14K, 925
  purityPercent Decimal     @db.Decimal(6, 4) // e.g. 0.9167 for 22K
  sellingRate   Decimal     @db.Decimal(12, 2) // Per 10g for Gold, per 1kg for Silver
  purchaseRate  Decimal     @db.Decimal(12, 2) // Old gold exchange basis
  effectiveAt   DateTime    @default(now()) @db.Timestamptz
  updatedById   String?
  source        String?     @default("MANUAL") @db.VarChar(50)
  notes         String?     @db.Text

  business      Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId, metal, effectiveAt(sort: Desc)])
  @@map("metal_rates")
}

// ==========================================
// 3. PRODUCT DESIGNS, STOCK & SERIALIZED ITEMS
// ==========================================

enum StockStatus {
  IN_SHOWCASE
  IN_VAULT
  RESERVED
  SOLD
  WITH_KARIGAR
  IN_REPAIR
  ON_MEMO
  DAMAGED
  RETURNED_TO_SUPPLIER
}

enum MakingType {
  PERCENTAGE
  PER_GRAM
  FIXED
}

model Product {
  id             String      @id @default(cuid())
  businessId     String
  name           String      @db.VarChar(150)
  category       String      @db.VarChar(50) // Rings, Bangles, Chains, Utensils
  metal          MetalType
  defaultPurity  String      @db.VarChar(10)
  description    String?     @db.Text
  hsnCode        String      @default("7113") @db.VarChar(10)
  standardMaking Decimal?    @db.Decimal(8, 2)
  makingType     MakingType  @default(PERCENTAGE)
  imageUrl       String?     @db.Text
  createdAt      DateTime    @default(now()) @db.Timestamptz

  business       Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  stockItems     StockItem[]

  @@index([businessId, category])
  @@map("products")
}

model StockItem {
  id              String          @id @default(cuid())
  businessId      String
  branchId        String?
  productId       String
  barcode         String          @unique @db.VarChar(50)
  sku             String          @db.VarChar(50)
  title           String          @db.VarChar(150)
  metal           MetalType
  purityKey       String          @db.VarChar(10)
  grossWeight     Decimal         @db.Decimal(10, 3)
  stoneWeight     Decimal         @default(0) @db.Decimal(10, 3)
  otherDeductions Decimal         @default(0) @db.Decimal(10, 3)
  netWeight       Decimal         @db.Decimal(10, 3)
  fineGoldEq      Decimal         @db.Decimal(10, 3)
  makingType      MakingType      @default(PERCENTAGE)
  makingValue     Decimal         @db.Decimal(8, 2)
  acquisitionCost Decimal         @db.Decimal(12, 2)
  trayLocation    String?         @db.VarChar(50)
  status          StockStatus     @default(IN_SHOWCASE)
  supplierId      String?
  huid            String?         @db.VarChar(20)
  dateAcquired    DateTime        @default(now()) @db.Timestamptz

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch          Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier        Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements       StockMovement[]
  invoiceItems    InvoiceItem[]

  @@index([businessId, status])
  @@index([businessId, barcode])
  @@map("stock_items")
}

model StockMovement {
  id            String      @id @default(cuid())
  stockItemId   String
  fromStatus    StockStatus
  toStatus      StockStatus
  reason        String      @db.VarChar(150)
  referenceType String?     @db.VarChar(50)
  referenceId   String?     @db.VarChar(100)
  fromLocation  String?     @db.VarChar(100)
  toLocation    String?     @db.VarChar(100)
  timestamp     DateTime    @default(now()) @db.Timestamptz
  performedById String?

  stockItem     StockItem   @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([stockItemId, timestamp])
  @@map("stock_movements")
}

// ==========================================
// 4. SALES, POS & BILLING
// ==========================================

enum InvoiceType {
  RETAIL_GST
  WHOLESALE_GST
  CASH_MEMO
  ESTIMATE
  OLD_GOLD_PURCHASE
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  CANCELLED
  REFUNDED
}

model Invoice {
  id               String        @id @default(cuid())
  businessId       String
  branchId         String?
  invoiceNumber    String        @db.VarChar(50)
  type             InvoiceType   @default(RETAIL_GST)
  status           InvoiceStatus @default(FINALIZED)
  invoiceDate      DateTime      @default(now()) @db.Timestamptz
  customerId       String?
  customerName     String        @db.VarChar(100)
  customerPhone    String        @db.VarChar(20)
  customerGstin    String?       @db.VarChar(15)
  customerCity     String?       @db.VarChar(50)

  subtotal         Decimal       @db.Decimal(12, 2)
  makingTotal      Decimal       @db.Decimal(12, 2)
  discountTotal    Decimal       @default(0) @db.Decimal(12, 2)
  taxableAmount    Decimal       @db.Decimal(12, 2)
  cgstAmount       Decimal       @default(0) @db.Decimal(12, 2)
  sgstAmount       Decimal       @default(0) @db.Decimal(12, 2)
  igstAmount       Decimal       @default(0) @db.Decimal(12, 2)
  roundOff         Decimal       @default(0) @db.Decimal(6, 2)
  grandTotal       Decimal       @db.Decimal(12, 2)
  oldGoldDeduction Decimal       @default(0) @db.Decimal(12, 2)
  netPayable       Decimal       @db.Decimal(12, 2)
  totalPaid        Decimal       @db.Decimal(12, 2)
  balanceDue       Decimal       @default(0) @db.Decimal(12, 2)
  createdById      String?
  createdAt        DateTime      @default(now()) @db.Timestamptz

  business         Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch           Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items            InvoiceItem[]
  payments         Payment[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId, invoiceDate(sort: Desc)])
  @@map("invoices")
}

model InvoiceItem {
  id            String     @id @default(cuid())
  invoiceId     String
  stockItemId   String?
  description   String     @db.VarChar(150)
  metal         MetalType
  purityKey     String     @db.VarChar(10)
  grossWeight   Decimal    @db.Decimal(10, 3)
  netWeight     Decimal    @db.Decimal(10, 3)
  metalRate     Decimal    @db.Decimal(12, 2)
  metalValue    Decimal    @db.Decimal(12, 2)
  makingCharges Decimal    @db.Decimal(10, 2)
  stoneValue    Decimal    @default(0) @db.Decimal(10, 2)
  discount      Decimal    @default(0) @db.Decimal(10, 2)
  itemSubtotal  Decimal    @db.Decimal(12, 2)

  invoice       Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  stockItem     StockItem? @relation(fields: [stockItemId], references: [id], onDelete: SetNull)

  @@map("invoice_items")
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OLD_GOLD
  CREDIT
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  method      PaymentMethod
  amount      Decimal       @db.Decimal(12, 2)
  referenceNo String?       @db.VarChar(100)
  paymentDate DateTime      @default(now()) @db.Timestamptz

  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ==========================================
// 5. CUSTOMERS & SUPPLIERS
// ==========================================

model Customer {
  id             String      @id @default(cuid())
  businessId     String
  name           String      @db.VarChar(100)
  phone          String      @db.VarChar(20)
  email          String?     @db.VarChar(100)
  city           String      @default("Jaipur") @db.VarChar(50)
  address        String?     @db.Text
  gstin          String?     @db.VarChar(15)
  panNumber      String?     @db.VarChar(10)
  totalPurchased Decimal     @default(0) @db.Decimal(12, 2)
  outstandingDue Decimal     @default(0) @db.Decimal(12, 2)
  loyaltyPoints  Int         @default(0)
  createdAt      DateTime    @default(now()) @db.Timestamptz

  business       Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  invoices       Invoice[]
  girviLoans     GirviLoan[]
  repairs        RepairJob[]
  bookings       CustomBookingOrder[]

  @@unique([businessId, phone])
  @@map("customers")
}

model Supplier {
  id                String            @id @default(cuid())
  businessId        String
  name              String            @db.VarChar(100)
  contactPerson     String?           @db.VarChar(100)
  phone             String            @db.VarChar(20)
  city              String            @db.VarChar(50)
  gstin             String?           @db.VarChar(15)
  metalSupplied     MetalType         @default(GOLD)
  outstandingDue    Decimal           @default(0) @db.Decimal(12, 2)
  fineGoldBalance   Decimal           @default(0) @db.Decimal(10, 3)
  fineSilverBalance Decimal           @default(0) @db.Decimal(10, 3)
  createdAt         DateTime          @default(now()) @db.Timestamptz

  business          Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  stockItems        StockItem[]
  purchases         PurchaseInvoice[]
  payments          SupplierPayment[]

  @@map("suppliers")
}

// ==========================================
// 6. PURCHASES & WHOLESALE INWARDING
// ==========================================

model PurchaseInvoice {
  id            String         @id @default(cuid())
  businessId    String
  supplierId    String
  invoiceNumber String         @db.VarChar(50)
  invoiceDate   DateTime       @default(now()) @db.Timestamptz
  supplierName  String         @db.VarChar(100)
  itemsSubtotal Decimal        @db.Decimal(12, 2)
  totalMaking   Decimal        @default(0) @db.Decimal(12, 2)
  totalGst      Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal        @db.Decimal(12, 2)
  amountPaid    Decimal        @default(0) @db.Decimal(12, 2)
  balanceDue    Decimal        @default(0) @db.Decimal(12, 2)
  paymentMethod String         @default("Cash") @db.VarChar(30)
  status        String         @default("paid") @db.VarChar(20)
  createdAt     DateTime       @default(now()) @db.Timestamptz

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items         PurchaseItem[]

  @@unique([businessId, invoiceNumber])
  @@map("purchase_invoices")
}

model PurchaseItem {
  id                String          @id @default(cuid())
  purchaseInvoiceId String
  description       String          @db.VarChar(150)
  category          String          @db.VarChar(50)
  metal             MetalType
  purity            String          @db.VarChar(10)
  grossWeight       Decimal         @db.Decimal(10, 3)
  stoneWeight       Decimal         @default(0) @db.Decimal(10, 3)
  netWeight         Decimal         @db.Decimal(10, 3)
  fineWeight        Decimal         @db.Decimal(10, 3)
  metalRate         Decimal         @db.Decimal(12, 2)
  makingRate        Decimal         @default(0) @db.Decimal(8, 2)
  subtotal          Decimal         @db.Decimal(12, 2)
  trayLocation      String          @db.VarChar(50)

  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  @@map("purchase_items")
}

model SupplierPayment {
  id           String    @id @default(cuid())
  businessId   String
  supplierId   String
  amount       Decimal   @db.Decimal(12, 2)
  method       String    @db.VarChar(30)
  referenceNo  String?   @db.VarChar(100)
  date         DateTime  @default(now()) @db.Timestamptz
  notes        String?   @db.Text

  business     Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  supplier     Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@map("supplier_payments")
}

// ==========================================
// 7. WHOLESALE CONSIGNMENT MEMOS (जांगड़)
// ==========================================

model B2BPartner {
  id             String            @id @default(cuid())
  businessId     String
  businessName   String            @db.VarChar(100)
  contactPerson  String            @db.VarChar(100)
  phone          String            @db.VarChar(20)
  city           String            @db.VarChar(50)
  address        String?           @db.Text
  gstin          String?           @db.VarChar(15)
  totalPurchased Decimal           @default(0) @db.Decimal(14, 2)
  createdAt      DateTime          @default(now()) @db.Timestamptz

  business       Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  memos          ConsignmentMemo[]

  @@map("b2b_partners")
}

model ConsignmentMemo {
  id                     String                @id @default(cuid())
  businessId             String
  b2bPartnerId           String?
  memoNumber             String                @db.VarChar(50)
  partnerName            String                @db.VarChar(100)
  partnerPhone           String                @db.VarChar(20)
  partnerCity            String?               @db.VarChar(50)
  partnerGstin           String?               @db.VarChar(15)
  issueDate              DateTime              @default(now()) @db.Timestamptz
  validUntilDate         DateTime              @db.Timestamptz
  totalPieces            Int
  totalGrossWeight       Decimal               @db.Decimal(10, 3)
  totalNetWeight         Decimal               @db.Decimal(10, 3)
  totalFineWeight        Decimal               @db.Decimal(10, 3)
  totalEstimatedValue    Decimal               @db.Decimal(14, 2)
  status                 String                @default("active_issued") @db.VarChar(30)
  convertedInvoiceNumber String?               @db.VarChar(50)
  notes                  String?               @db.Text
  createdAt              DateTime              @default(now()) @db.Timestamptz
  updatedAt              DateTime              @updatedAt @db.Timestamptz

  business               Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  b2bPartner             B2BPartner?           @relation(fields: [b2bPartnerId], references: [id], onDelete: SetNull)
  items                  ConsignmentMemoItem[]

  @@unique([businessId, memoNumber])
  @@map("consignment_memos")
}

model ConsignmentMemoItem {
  id             String          @id @default(cuid())
  memoId         String
  stockItemId    String?
  sku            String?         @db.VarChar(50)
  barcode        String?         @db.VarChar(50)
  name           String          @db.VarChar(150)
  category       String          @db.VarChar(50)
  metal          MetalType
  purity         String          @db.VarChar(10)
  grossWeight    Decimal         @db.Decimal(10, 3)
  netWeight      Decimal         @db.Decimal(10, 3)
  fineWeight     Decimal         @db.Decimal(10, 3)
  wholesaleRate  Decimal         @db.Decimal(12, 2)
  totalValue     Decimal         @db.Decimal(12, 2)
  status         String          @default("on_memo") @db.VarChar(30)

  memo           ConsignmentMemo @relation(fields: [memoId], references: [id], onDelete: Cascade)

  @@map("consignment_memo_items")
}

// ==========================================
// 8. KARIGAR & ARTISAN MANUFACTURING
// ==========================================

model Karigar {
  id                   String               @id @default(cuid())
  businessId           String
  name                 String               @db.VarChar(100)
  phone                String               @db.VarChar(20)
  workshopCity         String               @db.VarChar(50)
  specialty            String               @db.VarChar(100)
  pureGoldBalanceGrams Decimal              @default(0) @db.Decimal(10, 3)
  pureSilverBalance    Decimal              @default(0) @db.Decimal(10, 3)
  labourBalanceDue     Decimal              @default(0) @db.Decimal(12, 2)
  status               String               @default("active") @db.VarChar(20)
  createdAt            DateTime             @default(now()) @db.Timestamptz

  business             Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  metalTransactions    KarigarTransaction[]
  jobCards             JobCard[]

  @@map("karigars")
}

enum KarigarTxnType {
  ISSUE_METAL
  RECEIVE_ORNAMENT
  PAY_LABOUR
}

model KarigarTransaction {
  id              String         @id @default(cuid())
  karigarId       String
  type            KarigarTxnType
  date            DateTime       @default(now()) @db.Timestamptz
  metal           MetalType
  grossWeight     Decimal?       @db.Decimal(10, 3)
  netWeight       Decimal?       @db.Decimal(10, 3)
  fineWeightDelta Decimal        @default(0) @db.Decimal(10, 3)
  ornamentName    String?        @db.VarChar(100)
  labourAmount    Decimal?       @db.Decimal(10, 2)
  paymentAmount   Decimal?       @db.Decimal(10, 2)
  notes           String?        @db.Text

  karigar         Karigar        @relation(fields: [karigarId], references: [id], onDelete: Cascade)

  @@index([karigarId, date(sort: Desc)])
  @@map("karigar_transactions")
}

model JobCard {
  id                    String    @id @default(cuid())
  businessId            String
  karigarId             String
  jobCardNumber         String    @db.VarChar(50)
  karigarName           String    @db.VarChar(100)
  customerName          String?   @db.VarChar(100)
  customerPhone         String?   @db.VarChar(20)
  category              String    @db.VarChar(50)
  title                 String    @db.VarChar(150)
  description           String    @db.Text
  metal                 MetalType
  targetGrossWeight     Decimal   @db.Decimal(10, 3)
  targetNetWeight       Decimal   @db.Decimal(10, 3)
  purity                String    @db.VarChar(10)
  issuedFineWeightGrams Decimal   @default(0) @db.Decimal(10, 3)
  expectedDeliveryDate  DateTime  @db.Timestamptz
  status                String    @default("created") @db.VarChar(30)
  labourRate            Decimal   @db.Decimal(10, 2)
  labourType            String    @default("per_gram") @db.VarChar(20)
  allowedWastagePercent Decimal   @default(1.0) @db.Decimal(4, 2)
  huid                  String?   @db.VarChar(20)
  createdAt             DateTime  @default(now()) @db.Timestamptz
  completedAt           DateTime? @db.Timestamptz

  business              Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  karigar               Karigar   @relation(fields: [karigarId], references: [id], onDelete: Restrict)

  @@unique([businessId, jobCardNumber])
  @@map("job_cards")
}

// ==========================================
// 9. GIRVI & GOLD LOAN PAWN BOOK
// ==========================================

enum GirviStatus {
  ACTIVE
  RELEASED
  AUCTIONED
}

model GirviLoan {
  id                  String            @id @default(cuid())
  businessId          String
  loanNumber          String            @db.VarChar(50)
  packetNumber        String            @db.VarChar(50)
  safeLocation        String            @db.VarChar(50)
  customerId          String?
  customerName        String            @db.VarChar(100)
  customerPhone       String            @db.VarChar(20)
  customerCity        String            @default("Jaipur") @db.VarChar(50)
  customerAddress     String?           @db.Text

  startDate           DateTime          @default(now()) @db.Timestamptz
  dueDate             DateTime          @db.Timestamptz
  principalAmount     Decimal           @db.Decimal(12, 2)
  monthlyInterestRate Decimal           @db.Decimal(5, 2)
  durationMonths      Int               @default(6)
  status              GirviStatus       @default(ACTIVE)
  settledDate         DateTime?         @db.Timestamptz
  principalRepaid     Decimal           @default(0) @db.Decimal(12, 2)
  totalInterestPaid   Decimal           @default(0) @db.Decimal(12, 2)
  notes               String?           @db.Text

  business            Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer            Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  pledgedOrnaments    PledgedOrnament[]

  @@unique([businessId, loanNumber])
  @@index([businessId, status])
  @@index([businessId, packetNumber])
  @@map("girvi_loans")
}

model PledgedOrnament {
  id          String    @id @default(cuid())
  girviLoanId String
  name        String    @db.VarChar(100)
  metal       MetalType @default(GOLD)
  purity      String    @db.VarChar(10)
  grossWeight Decimal   @db.Decimal(10, 3)
  netWeight   Decimal   @db.Decimal(10, 3)

  girviLoan   GirviLoan @relation(fields: [girviLoanId], references: [id], onDelete: Cascade)

  @@map("pledged_ornaments")
}

// ==========================================
// 10. REPAIRS & CUSTOM BOOKINGS
// ==========================================

model RepairJob {
  id                 String    @id @default(cuid())
  businessId         String
  customerId         String?
  repairNumber       String    @db.VarChar(50)
  customerName       String    @db.VarChar(100)
  customerPhone      String    @db.VarChar(20)
  ornamentName       String    @db.VarChar(150)
  intakeGrossWeight  Decimal   @db.Decimal(10, 3)
  problemDescription String    @db.Text
  estimatedCost      Decimal   @db.Decimal(10, 2)
  advancePaid        Decimal   @default(0) @db.Decimal(10, 2)
  status             String    @default("received") @db.VarChar(30)
  intakeDate         DateTime  @default(now()) @db.Timestamptz
  deliveryPromiseDate DateTime @db.Timestamptz
  deliveredAt        DateTime? @db.Timestamptz

  business           Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([businessId, repairNumber])
  @@map("repair_jobs")
}

model CustomBookingOrder {
  id                   String   @id @default(cuid())
  businessId           String
  customerId           String?
  orderNumber          String   @db.VarChar(50)
  customerName         String   @db.VarChar(100)
  customerPhone        String   @db.VarChar(20)
  ornamentType         String   @db.VarChar(100)
  targetGrossWeight    Decimal  @db.Decimal(10, 3)
  purity               String   @db.VarChar(10)
  lockedGoldRatePer10g Decimal? @db.Decimal(12, 2)
  advanceAmountPaid    Decimal  @db.Decimal(12, 2)
  estimatedTotalAmount Decimal  @db.Decimal(12, 2)
  deliveryPromiseDate  DateTime @db.Timestamptz
  status               String   @default("placed") @db.VarChar(30)
  createdAt            DateTime @default(now()) @db.Timestamptz

  business             Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer             Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([businessId, orderNumber])
  @@map("custom_booking_orders")
}

// ==========================================
// 11. STAFF & PAYROLL
// ==========================================

model StaffMember {
  id             String         @id @default(cuid())
  businessId     String
  name           String         @db.VarChar(100)
  phone          String         @db.VarChar(20)
  role           String         @db.VarChar(50)
  monthlySalary  Decimal        @db.Decimal(10, 2)
  advanceBalance Decimal        @default(0) @db.Decimal(10, 2)
  joiningDate    DateTime       @default(now()) @db.Timestamptz
  status         String         @default("active") @db.VarChar(20)

  business       Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  payments       StaffPayment[]

  @@map("staff_members")
}

model StaffPayment {
  id          String      @id @default(cuid())
  businessId  String
  staffId     String
  amount      Decimal     @db.Decimal(10, 2)
  type        String      @db.VarChar(20) // "salary", "advance"
  paymentMode String      @default("Cash") @db.VarChar(30)
  monthYear   String?     @db.VarChar(20)
  date        DateTime    @default(now()) @db.Timestamptz
  notes       String?     @db.Text

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  staff       StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_payments")
}

// ==========================================
// 12. DOUBLE-ENTRY ACCOUNTS, EXPENSES & CASH CLOSING
// ==========================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id             String        @id @default(cuid())
  businessId     String
  code           String        @db.VarChar(20)
  name           String        @db.VarChar(100)
  type           AccountType
  currentBalance Decimal       @default(0) @db.Decimal(14, 2)

  business       Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  journalLines   JournalLine[]

  @@unique([businessId, code])
  @@map("accounts")
}

model JournalEntry {
  id            String        @id @default(cuid())
  businessId    String
  voucherNumber String        @db.VarChar(50)
  date          DateTime      @default(now()) @db.Timestamptz
  description   String        @db.Text
  lines         JournalLine[]

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  debitAmount    Decimal      @default(0) @db.Decimal(12, 2)
  creditAmount   Decimal      @default(0) @db.Decimal(12, 2)

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@map("journal_lines")
}

model ShopExpense {
  id            String   @id @default(cuid())
  businessId    String
  category      String   @db.VarChar(100)
  amount        Decimal  @db.Decimal(10, 2)
  paymentMode   String   @db.VarChar(30)
  paidTo        String   @db.VarChar(100)
  voucherNumber String?  @db.VarChar(50)
  date          DateTime @default(now()) @db.Timestamptz
  notes         String?  @db.Text
  recordedBy    String   @db.VarChar(100)

  business      Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@map("shop_expenses")
}

model DailyCashClosing {
  id               String   @id @default(cuid())
  businessId       String
  date             String   @db.VarChar(20)
  openingCash      Decimal  @db.Decimal(12, 2)
  cashSales        Decimal  @db.Decimal(12, 2)
  cashAdvances     Decimal  @db.Decimal(12, 2)
  supplierCashPaid Decimal  @db.Decimal(12, 2)
  karigarCashPaid  Decimal  @db.Decimal(12, 2)
  cashExpenses     Decimal  @db.Decimal(12, 2)
  expectedCash     Decimal  @db.Decimal(12, 2)
  physicalCash     Decimal  @db.Decimal(12, 2)
  discrepancy      Decimal  @db.Decimal(12, 2)
  status           String   @db.VarChar(20)
  denominations    Json
  closedBy         String   @db.VarChar(100)
  closedAt         DateTime @default(now()) @db.Timestamptz
  notes            String?  @db.Text

  business         Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, date])
  @@map("daily_cash_closings")
}

// ==========================================
// 13. AUDIT LOGS
// ==========================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(50)
  entityId   String   @db.VarChar(100)
  oldData    Json?
  newData    Json?
  timestamp  DateTime @default(now()) @db.Timestamptz

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([timestamp(sort: Desc)])
  @@map("audit_logs")
}
